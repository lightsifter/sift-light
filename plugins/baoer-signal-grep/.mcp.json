{
  "mcpServers": {
    "baoer_signal_grep": {
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "baoer_signal_grep@latest",
        "baoer_signal_grep_mcp",
        "--stdio"
      ],
      "env": {
        "npm_config_ignore_scripts": "true",
        "ONNXRUNTIME_NODE_INSTALL_CUDA": "skip",
        "BAOER_SIGNAL_GREP_MCP_OUTPUT_MODE": "model"
      },
      "env_vars": [
        "BAOER_SIGNAL_GREP_CONFIG",
        "TYPESAFE_API_KEY"
      ]
    }
  }
}
